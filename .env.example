# Copy to .env.local (gitignored). Optional: without these the app works offline and the account section is disabled.
# See supabase/README.md. Use the anon / publishable key, never the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Study reminders in the web app (Web Push): the PUBLIC key of the VAPID pair (supabase/README.md, "Reminders in the
# web app"). The private key never goes here: only into the Edge Function's secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
